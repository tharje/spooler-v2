# Spooler environment variables
# Copy this file to .env and fill in the values.

# ── Authentication ─────────────────────────────────────────────────────────────

# Set to false to disable authentication entirely (for trusted LAN use only).
# AUTH_ENABLED=true

# Username for the login form (default: admin).
# SPOOLER_USERNAME=admin

# bcrypt hash of your password. Overrides any password set via the web UI.
# Generate one with:  python3 server.py --hash-password
# SPOOLER_PW_HASH=$2b$12$changeme

# ── Ports ──────────────────────────────────────────────────────────────────────

# HTTP_PORT=8080
# HTTPS_PORT=8443
# WS_PORT=8765

# The HTTP server (HTTP_PORT) also accepts WebSocket upgrades on the same
# port ("combo" mode), so a single-port tunnel/reverse proxy — e.g. a
# Cloudflare Tunnel hostname pointed at http://<ip>:8080 — works out of the
# box with no extra config: the browser just reconnects to its own page
# origin. You normally do NOT need to set anything here.
#
# WS_HOST is only for the rare case where the WS connection needs to go to a
# different public hostname than the page itself (e.g. HTTPS_PORT=443 run
# directly with no reverse proxy in front, where combo isn't possible).
# WS_HOST=ws.example.com

# ── TLS / HTTPS ────────────────────────────────────────────────────────────────

# Set to false when running behind a reverse proxy (Traefik, nginx, Caddy, etc.)
# that handles TLS termination. Disables the built-in self-signed cert and HTTPS server.
# HTTPS_ENABLED=true

# Set to true when behind a TLS-terminating reverse proxy so the session cookie
# carries the Secure flag (even though the app itself is serving HTTP internally).
# SECURE_COOKIES=false

# ── Spoolman ───────────────────────────────────────────────────────────────────

# Spoolman API / UI base URL.
# SPOOLMAN_URL=http://localhost:7912

# When true (default), Spoolman's web UI is proxied through /spoolman/ on this
# server so you can access it without leaving the Spooler app.
# When false, the /spoolman link redirects the browser directly to SPOOLMAN_URL
# (better experience — full WebSocket support, no proxy overhead).
# PROXY_SPOOLMAN=true

# ── Debug ──────────────────────────────────────────────────────────────────────

# Set to 1 to enable verbose MQTT/protocol logging (full payloads, unknown keys).
# DEBUG=0

