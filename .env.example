# Spooler environment variables
# Copy this file to .env and fill in the values.

# ── Authentication ─────────────────────────────────────────────────────────────

# Set to false to disable authentication entirely (for trusted LAN use only).
# AUTH_ENABLED=true

# Username for the login form (default: admin).
# SPOOLER_USERNAME=admin

# bcrypt hash of your password. Overrides any password set via the web UI.
# Generate one with:  python3 server.py --hash-password
# SPOOLER_PW_HASH=$2b$12$changeme

# ── Ports ──────────────────────────────────────────────────────────────────────

# HTTP_PORT=8080
# HTTPS_PORT=8443
# WS_PORT=8765

# The HTTP server (HTTP_PORT) also accepts WebSocket upgrades on the same
# port ("combo" mode), so a single-port tunnel/reverse proxy — e.g. a
# Cloudflare Tunnel hostname pointed at http://<ip>:8080 — works out of the
# box with no extra config: the browser just reconnects to its own page
# origin. You normally do NOT need to set anything here.
#
# WS_HOST is only for the rare case where the WS connection needs to go to a
# different public hostname than the page itself (e.g. HTTPS_PORT=443 run
# directly with no reverse proxy in front, where combo isn't possible).
# WS_HOST=ws.example.com

# ── TLS / HTTPS ────────────────────────────────────────────────────────────────

# Set to false when running behind a reverse proxy (Traefik, nginx, Caddy, etc.)
# that handles TLS termination. Disables the built-in self-signed cert and HTTPS server.
# HTTPS_ENABLED=true

# Set to true when behind a TLS-terminating reverse proxy so the session cookie
# carries the Secure flag (even though the app itself is serving HTTP internally).
# SECURE_COOKIES=false

# ── Spoolman ───────────────────────────────────────────────────────────────────
#
# These are now just the DEFAULT values -- Settings -> Integrations in the web
# UI is the primary way to configure Spoolman, and a value set there overrides
# whatever's here without needing a restart. Leave these as the fallback for a
# fresh install / unattended deploy; set SPOOLER_LOCK_CONFIG=1 below if you
# don't want the UI able to override them at all.

# Spoolman API / UI base URL.
# SPOOLMAN_URL=http://localhost:7912

# When true (default), Spoolman's web UI is proxied through /spoolman/ on this
# server so you can access it without leaving the Spooler app.
# When false, the /spoolman link redirects the browser directly to SPOOLMAN_URL
# (better experience — full WebSocket support, no proxy overhead).
# PROXY_SPOOLMAN=true

# ── Integrations config ──────────────────────────────────────────────────────

# Set to 1 to make every Settings -> Integrations field read-only, with
# environment variables always winning over anything saved from the UI --
# for someone hosting Spooler for other people who shouldn't be able to
# repoint it at a different Spoolman instance, etc. Can only force values,
# never loosen them; there's no equivalent "unlock a specific field" option.
# SPOOLER_LOCK_CONFIG=0

# ── Features ───────────────────────────────────────────────────────────────────

# Comma-separated feature keys to force off regardless of what's set in
# Settings -> Features (e.g. for an operator who manages Spooler for someone
# else and wants camera streaming unavailable no matter what the user picks).
# This can only force a feature OFF, never on. Locked features show as such
# in the UI. See features.py for the current list of feature keys.
# SPOOLER_FORCE_DISABLE=camera,spoolman

# ── Backup ─────────────────────────────────────────────────────────────────────

# Automatic backups are taken on version upgrades (always -- they protect
# against a bad migration, not something you'd want to opt out of) and on an
# interval into DATA_DIR/backups/, downloadable from Settings -> Backup.
# This is just the default -- change it from Settings -> Backup without a
# restart. Set to 0 to disable the interval-based one.
# SPOOLER_BACKUP_INTERVAL_DAYS=1

# How many automatic backups to keep before deleting the oldest.
# SPOOLER_BACKUP_KEEP=7

# Maximum G-code upload size in MB (file upload from the file browser).
# SPOOLER_MAX_UPLOAD_MB=500

# ── Debug ──────────────────────────────────────────────────────────────────────

# Set to 1 to enable verbose MQTT/protocol logging (full payloads, unknown keys).
# DEBUG=0

# Set to 1 to dump every raw message from every printer to DATA_DIR/raw/<id>.ndjson,
# for collecting real protocol fixtures for the test suite. Off by default: raw
# messages can contain printer serial numbers and access codes — anonymize before
# sharing or committing anything captured from DATA_DIR/raw/.
# SPOOLER_DEBUG_RAW=0

